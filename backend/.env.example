# Application
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=socio_lk_pos_dev

# JWT — generate strong random strings (e.g., openssl rand -hex 32)
JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_DOMAIN=localhost
# Exactly true or false. false is for local HTTP development and tests;
# production (NODE_ENV=production) refuses to start unless it is true.
COOKIE_SECURE=false

# Proxies whose X-Forwarded-For sets the client IP. false (or unset): none,
# for local development and tests. Otherwise a hop count (1-5) or a
# comma-separated list of proxy IPs/CIDRs (at least /8 IPv4, /32 IPv6);
# true is rejected. Production (NODE_ENV=production) refuses to start
# unless it is set explicitly, even to false.
TRUST_PROXY=false

# POST /auth/login requests allowed per client IP per window (whole numbers;
# limit 1-1000, window 1-86400 seconds). Defaults 20 per 900 s when unset.
LOGIN_THROTTLE_LIMIT=20
LOGIN_THROTTLE_TTL_SECONDS=900